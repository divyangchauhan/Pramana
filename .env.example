# Pramana — environment variables
#
# Copy to `.env` and fill in the provider you plan to run. Only the provider
# passed via `--provider` needs its key set; `--self-check` needs no keys at all.
#
# The app auto-loads this file at startup and refuses to start a real run if the
# selected provider's credential is missing. Real exported environment variables
# take precedence over values here.

# --- Anthropic (Claude) — provider: anthropic ---
ANTHROPIC_API_KEY=

# --- OpenAI — provider: openai ---
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint — a gateway (OpenRouter,
# LiteLLM), a local server (vLLM, Ollama), or a proxy. The OpenAI SDK reads this
# variable directly. `--model` must name a model that endpoint serves; a wrong
# id fails at startup and lists what is actually available.
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# OPENAI_BASE_URL=

# --- Kimi / Moonshot AI — provider: kimi ---
# MOONSHOT_API_KEY is preferred; KIMI_API_KEY is accepted as an alias.
MOONSHOT_API_KEY=
# Optional: override the OpenAI-compatible base URL (default shown below).
# Use the .cn endpoint if your account is on Moonshot China.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
